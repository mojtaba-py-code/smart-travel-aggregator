# Copy to .env and fill in. Never commit the real .env.

# --- general ---
APP_NAME="Smart Travel Aggregator"
ENVIRONMENT=development           # development | test | staging | production
DEBUG=true
API_PREFIX=/api/v1

# --- security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL=900              # seconds (15 min)
REFRESH_TOKEN_TTL=1209600        # seconds (14 days)
CORS_ORIGINS=http://localhost:3000
# Bearer tokens need no cookies; leave off. "*" plus credentials is refused in production.
CORS_ALLOW_CREDENTIALS=false

# --- persistence ---
DATABASE_URL=postgresql+asyncpg://travel:travel@localhost:5432/travel
REDIS_URL=redis://localhost:6379/0

# --- rate limiting ---
RATE_LIMIT_PER_MINUTE=120

# --- external providers ---
WEATHER_BASE_URL=https://api.open-meteo.com/v1
CURRENCY_BASE_URL=https://api.exchangerate.host
HTTP_TIMEOUT_SECONDS=5.0
HTTP_MAX_RETRIES=2
PROVIDER_CACHE_TTL=300
